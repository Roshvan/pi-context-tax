{
	"name": "pi-context-tax",
	"version": "0.2.0",
	"packageManager": "pnpm@11.24.0",
	"description": "Inspect Pi's startup tax, current context, and recorded session tokens, cost, tools, and MCP calls",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Roshvan/pi-context-tax.git"
	},
	"bugs": {
		"url": "https://github.com/Roshvan/pi-context-tax/issues"
	},
	"homepage": "https://github.com/Roshvan/pi-context-tax#readme",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"coding-agent",
		"context-window",
		"startup-tax",
		"tokens",
		"tui"
	],
	"files": [
		"extensions",
		"src",
		"docs/*.png",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"check": "tsc --noEmit && oxlint",
		"dev": "pi -e ./extensions/context-tax.ts",
		"lint": "oxlint",
		"pack:check": "pnpm pack --dry-run",
		"prepublishOnly": "pnpm check && pnpm pack:check"
	},
	"pi": {
		"extensions": [
			"./extensions/context-tax.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.0.4",
		"@earendil-works/pi-coding-agent": "1.0.4",
		"@earendil-works/pi-tui": "1.0.4",
		"@oxlint/plugins": "^1.80.0",
		"@types/node": "^22.20.1",
		"oxlint": "^1.80.0",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
